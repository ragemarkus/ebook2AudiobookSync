# Remote GPU worker (G14).  Copy to worker.env.  Never commit it.
# The companion on the XPS (LAN address; it is not exposed publicly).
COMPANION_URL=http://<xps-host>:8765
# Same value as WORKER_TOKEN in the XPS's .env
WORKER_TOKEN=
WORKER_NAME=g14
WHISPER_MODEL=medium.en
WHISPER_DEVICE=cuda
POLL_SECONDS=60
