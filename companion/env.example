# Read-along companion (XPS).  Copy to .env.  Never commit .env.

# Image version from GHCR (docker compose pull): latest, or a release like 0.2.0
COMPANION_TAG=latest

# --- Audiobookshelf --------------------------------------------------------
# On the LAN, talk to ABS directly (no Cloudflare). Use your ABS host/port.
ABS_URL=http://<abs-host>:13378
# ABS API token: ABS > Settings > Users > (you) > API token.  An admin token
# also allows ABS_SCAN_AFTER_PUBLISH.
ABS_TOKEN=
# Only if ABS_URL is the public hostname behind Cloudflare Access
# (https://<abs-public-host>): a Cloudflare Access service token with a Service Auth policy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Limit to some libraries (comma-separated ids); empty = every book library.
ABS_LIBRARY_IDS=

# --- The library folder (so sidecars land in the ABS item folder) ---------
# Host folder that ABS uses as its library (mounted at /library in the container)
ABS_LIBRARY_HOST_PATH=/path/to/audiobooks
# ABS's own path for that folder = path inside this container. Shown in ABS as the
# library folder / item path, e.g. /audiobooks when ABS runs in Docker.
ABS_PATH_MAP=/audiobooks=/library
# Ask ABS to rescan the item after writing the sidecar (needs an admin ABS_TOKEN;
# otherwise ABS's folder watcher or the next library scan picks it up).
ABS_SCAN_AFTER_PUBLISH=false
# uid:gid that owns the library files (docker compose user:)
PUID=1000
PGID=1000

# --- Who generates ------------------------------------------------------------
# local  = the XPS does everything on its CPU (slow, hours per book with small.en)
# remote = only remote workers (the G14) generate; the XPS just queues and publishes
# both   = the G14 gets first pick; the XPS takes jobs that waited LOCAL_CLAIM_DELAY seconds
# off    = scan and serve only
WORKER_MODE=local
LOCAL_CLAIM_DELAY=21600
# Shared secret for remote workers (needed for remote/both). e.g. `openssl rand -hex 32`
WORKER_TOKEN=
# Protects POST /api/rescan and /regenerate (the UI asks for it once). Recommended.
ADMIN_TOKEN=

# --- Generator (sidecar/make_readalong_sidecar.py) ---------------------------
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
# Quality gate: below this share of matched narrated words the sidecar is held
# as needs_review instead of being published (wrong edition / abridged audio).
MIN_MATCH=0.85
MIN_XPOINTER=0.9

# --- Queue / schedule ----------------------------------------------------------
SCAN_INTERVAL=21600
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=600
LEASE_SECONDS=900
KEEP_WORK=false
