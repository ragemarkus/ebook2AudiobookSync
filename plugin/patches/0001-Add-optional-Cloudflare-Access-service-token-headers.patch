+-- ---------------------------------------------------------------------------
+-- [cf-access patch] Cloudflare Access service-token dialog
+-- ---------------------------------------------------------------------------
+
+function ABSBrowse._showAccessSettings(plugin, touchmenu_instance)
+    local MultiInputDialog = require("ui/widget/multiinputdialog")
+    local pp = plugin.path and (plugin.path .. "/") or "./"
+    local ABSClient
+    pcall(function() ABSClient = dofile(pp .. "absclient.lua") end)
+
+    local function refresh()
+        if touchmenu_instance then touchmenu_instance:updateItems() end
+    end
+
+    local dialog
+    dialog = MultiInputDialog:new{
+        title = _("Cloudflare Access service token"),
+        description = _("Only needed when your Audiobookshelf URL is protected by Cloudflare Access. Leave both blank to turn this off. Values are sent only to the Audiobookshelf host."),
+        fields = {
+            {
+                text = plugin:getSetting("abs_cf_access_client_id", ""),
+                hint = _("CF-Access-Client-Id (ends in .access)"),
+            },
+            {
+                text = plugin:getSetting("abs_cf_access_client_secret", ""),
+                hint = _("CF-Access-Client-Secret"),
+                text_type = "password",
+            },
+        },
+        buttons = {
+            {
+                {
+                    text = _("Cancel"),
+                    id = "close",
+                    callback = function()
+                        UIManager:close(dialog)
+                    end,
+                },
+                {
+                    text = _("Clear"),
+                    callback = function()
+                        plugin:setSetting("abs_cf_access_client_id", "")
+                        plugin:setSetting("abs_cf_access_client_secret", "")
+                        UIManager:close(dialog)
+                        refresh()
+                        UIManager:show(InfoMessage:new{
+                            text = _("Cloudflare Access token cleared."),
+                            timeout = 2,
+                        })
+                    end,
+                },
+            },
+            {
+                {
+                    text = _("Save & test"),
+                    is_enter_default = true,
+                    callback = function()
+                        local fields = dialog:getFields()
+                        local id = (fields[1] or ""):gsub("^%s+", ""):gsub("%s+$", "")
+                        local secret = (fields[2] or ""):gsub("^%s+", ""):gsub("%s+$", "")
+                        plugin:setSetting("abs_cf_access_client_id", id)
+                        plugin:setSetting("abs_cf_access_client_secret", secret)
+                        UIManager:close(dialog)
+                        refresh()
+                        local server_url = plugin:getSetting("abs_server_url", "")
+                        if not ABSClient or server_url == "" then
+                            UIManager:show(InfoMessage:new{
+                                text = _("Saved. Set the server URL to test the connection."),
+                                timeout = 3,
+                            })
+                            return
+                        end
+                        UIManager:show(InfoMessage:new{
+                            text = _("Testing connection…"),
+                            timeout = 1,
+                        })
+                        UIManager:scheduleIn(0.3, function()
+                            local client = ABSClient:new{ server_url = server_url }
+                            local ok, err = client:pingServer()
+                            UIManager:show(InfoMessage:new{
+                                text = ok and _("Saved. Audiobookshelf is reachable through Cloudflare Access.")
+                                    or (_("Saved, but the test failed: ") .. tostring(err)),
+                                timeout = ok and 3 or 6,
+                            })
+                        end)
+                    end,
+                },
+            },
+        },
+    }
+    UIManager:show(dialog)
+    dialog:onShowKeyboard()
+end
