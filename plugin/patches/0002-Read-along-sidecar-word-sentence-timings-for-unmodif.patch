+local function foldChars(s)
+    s = tostring(s or ""):lower()
+    return (s:gsub("[%z\1-\47\58-\64\91-\96\123-\127]", ""))
+end
+
+--- Read-along sidecar: word boxes come from walking crengine words from the
+--- cue's resolved start xpointer (the sidecar cue has no on-page text
+--- context).  Sidecar words map onto crengine words by folded-character
+--- position, so differing tokenisation (em-dashes, hyphens) cannot drift.
+function HighlightManager:_highlightSidecarWord(word, sentence)
+    local doc = self.ui and self.ui.document
+    local parser = self.plugin and self.plugin._smil_parser
+    if not (doc and parser and parser.resolveFragment and sentence.words) then return end
+    local idx
+    for i, w in ipairs(sentence.words) do
+        if w == word then idx = i break end
+    end
+    if not idx then return end
+    local walk = self._sc_word_walk
+    if not walk or walk.fid ~= sentence.fragment_id then
+        local xp0 = parser:resolveFragment(doc, sentence.fragment_id)
+        if not xp0 then return end
+        walk = { fid = sentence.fragment_id, words = {} }
+        local total = #foldChars(sentence.text)
+        local pos, ws = 0, xp0
+        for _ = 1, #sentence.words + 40 do
+            local we
+            pcall(function() we = doc:getNextVisibleWordEnd(ws) end)
+            if not we then break end
+            local t = ""
+            pcall(function() t = doc:getTextFromXPointers(ws, we) or "" end)
+            local n = #foldChars(t)
+            walk.words[#walk.words + 1] = { ws = ws, we = we, c0 = pos, c1 = pos + n }
+            pos = pos + n
+            if pos >= total then break end
+            local nxt
+            pcall(function() nxt = doc:getNextVisibleWordStart(we) end)
+            if not nxt or nxt == ws then break end
+            ws = nxt
+        end
+        self._sc_word_walk = walk
+    end
+    local c = 0
+    for i = 1, idx - 1 do c = c + #foldChars(sentence.words[i].text) end
+    local target
+    for _, w in ipairs(walk.words) do
+        if c >= w.c0 and c < math.max(w.c1, w.c0 + 1) then target = w break end
+    end
+    if not target then return end
+    local boxes
+    pcall(function() boxes = doc:getScreenBoxesFromPositions(target.ws, target.we, true) end)
+    if not boxes or #boxes == 0 then return end
