+--- Where findSidecar also looks: sidecars fetched with ABS downloads,
+--- matched by file name or by the open book's title.
+function Audiobook:_readalongFindOpts()
+    local title
+    pcall(function()
+        local props = self.ui and self.ui.document and self.ui.document:getProps()
+        title = props and props.title
+    end)
+    return { abs_cache_dir = PLUGIN_PATH .. "abs_cache", title = title }
+end
