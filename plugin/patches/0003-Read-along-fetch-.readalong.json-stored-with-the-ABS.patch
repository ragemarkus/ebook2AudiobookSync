diff --git a/absbrowse.lua b/absbrowse.lua
index 47f18aa..915a795 100644
--- a/absbrowse.lua
+++ b/absbrowse.lua
@@ -1390,12 +1390,26 @@ function ABSBrowse._downloadItem(plugin, client, item, cache, refresh_callback)
                 -- Add to cache index
                 cache:addItem(item, downloaded_paths, cover_ok and cover_path or nil, audio_durations)
 
+                -- Read-along sidecar stored with the audiobook on the server
+                -- (any "*.readalong.json" in the item's folder): fetch it so
+                -- the matching EPUB gets word/sentence read-along.
+                local got_sidecar = false
